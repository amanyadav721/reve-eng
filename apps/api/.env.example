# Copy to .env and fill in. Every key is optional; /health shows what's configured.
PORT=8787

# Clerk: dashboard → API keys. JWT key (PEM) enables verification without a network call.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=

# Local only: accept "Authorization: Dev user_xxx" before Clerk is set up. Never in production.
ALLOW_DEV_AUTH=1

# Sarvam AI: https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Supabase: project settings → API. The service role key stays on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Places and routes. Without a Google key we use our own: the open-data places database
# (npm run data:places -w api -- jaipur) and the Valhalla server (infra/valhalla).
PLACES_PROVIDER=
ROUTES_PROVIDER=
VALHALLA_URL=http://localhost:8002
GOOGLE_MAPS_API_KEY=

# Weather, web search
OPENWEATHER_API_KEY=
TAVILY_API_KEY=
