{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "test": "tsx --test 'src/**/*.test.ts' 'evals/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "eval": "tsx --env-file-if-exists=.env evals/run.ts",
    "data:places": "tsx data/build-places.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.25.0",
    "@duckdb/node-api": "^1.5.6-r.1",
    "@hono/node-server": "^2.1.5",
    "@photostructure/tz-lookup": "^11.7.0",
    "@tagalong/shared": "*",
    "hono": "^4.13.13",
    "opening_hours": "^3.15.0",
    "suncalc": "^2.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
